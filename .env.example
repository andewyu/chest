# --- AWS / Bedrock ---
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Auth: AWS now supports a Bedrock-only long-term API key, which is simpler
# than a full IAM access key/secret for local dev (Bedrock console -> API
# keys -> "Generate long-term API key"). Paste it here and boto3 picks it up
# automatically via the AWS_BEARER_TOKEN_BEDROCK env var — no ~/.aws/credentials
# needed. It only authorizes Bedrock calls; deploying to AgentCore/EventBridge/
# DynamoDB later still needs a real IAM user or `aws configure sso`.
AWS_BEARER_TOKEN_BEDROCK=

# --- Storage ---
# local | dynamodb
CHEST_STORE=local
DDB_LEDGER_TABLE=chest-ledger

# --- Channel: pick one ---
CHEST_CHANNEL=telegram

# Telegram (fastest to set up: talk to @BotFather, get a token instantly)
TELEGRAM_BOT_TOKEN=
# Generate 32+ random URL-safe characters. Pass the same value as secret_token
# when registering the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=

# Twilio WhatsApp Sandbox (no sender registration required)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Exact public HTTPS origin used by Twilio, e.g. https://abc123.ngrok.app.
# Required when a proxy makes the URL seen by FastAPI differ from the public URL.
PUBLIC_BASE_URL=

# iMessage via Blooio (https://blooio.com) — third-party relay, not an Apple
# API. Set CHEST_CHANNEL=imessage to use it. Register the webhook URL
# (<ngrok>/imessage) in the Blooio dashboard once reachable.
BLOOIO_API_KEY=
BLOOIO_WEBHOOK_SECRET=
BLOOIO_FROM_NUMBER=

# --- Demo org profile (used by the Eligibility Screener) ---
ORG_NAME=Riverside Neighborhood Heritage Museum
ORG_EIN=00-0000000
ORG_TYPE=Nonprofits having a 501(c)(3) status other than institutions of higher education
ORG_ANNUAL_BUDGET=42000
ORG_STATE=IN
ORG_MISSION_KEYWORDS=museum,local history,heritage preservation

# Public https URL of the signup page (ngrok URL in dev). The bot puts this in
# front of anyone who texts it without an account.
PUBLIC_URL=
# Shown in signup instructions, e.g. ChestAssistbot (no @). Optional — the app
# asks Telegram for it via getMe when a bot token is set.
TELEGRAM_BOT_USERNAME=
